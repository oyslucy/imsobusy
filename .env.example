# Optional. Defaults to "/api" (same-origin), which works both in dev
# (proxied to the backend by Vite) and in the integrated production build
# (served by FastAPI itself). Only set this if the API lives elsewhere.
# VITE_API_BASE_URL=http://localhost:8000/api

# --- Used by docker-compose.yml when deploying with Docker ---
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Comma-separated origins allowed to call the API. Same-origin deploys
# (this Docker setup) don't strictly need this, but keep it accurate.
# e.g. CORS_ORIGINS=https://your-domain.duckdns.org,http://<VM_PUBLIC_IP>
CORS_ORIGINS=http://localhost
